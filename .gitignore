# LegionClaw .gitignore

# === 构建产物 ===
**/build/
**/install/
**/log/
**/CMakeCache.txt
**/CMakeFiles/
modules/**/make/*.cmake

# 忽略 bin/ 下的二进制文件，但保留 bin/conf/ 配置
modules/**/bin/*
!modules/**/bin/conf/
!modules/**/bin/conf/**/

# === 数据（bag/PCD/PNG 很大）===
data/
output/
test_result/

# === 日志 ===
*.log

# === 系统 ===
.vscode/
.idea/
__pycache__/
*.pyc
.DS_Store
/tmp/

# === 备份 ===
*.bak
